# Configuración opcional de Firebase (Respaldo en la nube real con cuenta de Google)
# Si no se especifican, la app funciona automáticamente con el Respaldo Simulado de Cuenta Google + IndexedDB local
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Endpoint opcional del Backend Seguro (Cloud Functions / API Server) para IA y eBird
# Los secretos de Google Gemini / Imagen y eBird deben vivir en el servidor/backend, NUNCA en el cliente
VITE_BACKEND_API_URL=
