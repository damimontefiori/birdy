# ==============================================================================
# Motor de IA (SOLO SERVIDOR — nunca lleva prefijo VITE_ ni se expone al cliente)
# ==============================================================================
# Conseguí tu clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelos opcionales de Google Gemini (podés dejar los valores por defecto)
# GEMINI_VISION_MODEL=gemini-3.1-flash-lite
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Respaldos GRATUITOS de VISIÓN (sin tarjeta de crédito) ante picos 503 de Google Gemini Free Tier:
# Opción recomendada (Groq — ultrarrápido ~1s, 1000 req/día gratis en https://console.groq.com/keys):
# GROQ_API_KEY=gsk_...
# Alternativa (OpenRouter modelos :free en https://openrouter.ai/keys):
# OPENROUTER_API_KEY=sk-or-...

# Respaldo GRATUITO (sin tarjeta ni marcas de agua) para visión y para pintar murales/acuarelas por IA:
# Opción 1 (Hugging Face — crear token gratis en https://huggingface.co/settings/tokens con permiso Inference Providers):
# HUGGINGFACE_API_KEY=hf_...
# Opción 2 (Cloudflare Workers AI — capa gratuita diaria en https://dash.cloudflare.com):
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# ==============================================================================
# Autenticación real con Google + Protección de cuota de Gemini
# ==============================================================================
# ID de cliente OAuth 2.0 (Web) creado en Google Cloud Console -> APIs y servicios -> Credenciales
GOOGLE_CLIENT_ID=

# Correos de Google autorizados (separados por coma). Por defecto:
ALLOWED_EMAILS=valedepadua@gmail.com,damiyvale@gmail.com

# Clave secreta aleatoria (>=32 caracteres) para firmar la cookie HttpOnly de sesión en producción
AUTH_SESSION_SECRET=

# Forzar autenticación incluso en desarrollo (en producción siempre es obligatoria)
# REQUIRE_GOOGLE_AUTH=true

# ==============================================================================
# Configuración opcional del cliente
# ==============================================================================
# Si el backend corre en otro dominio, indicá su URL base
VITE_BACKEND_API_URL=

# Firebase (respaldo real en la nube con cuenta de Google; opcional)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
