# ==============================================================================
# 1. Motor de IA — Visión e Ilustraciones 100% IA (SOLO SERVIDOR, nunca VITE_)
# ==============================================================================
# Clave de Google Gemini (https://aistudio.google.com/apikey)
# - Visión: funciona gratis con gemini-3-flash-preview / gemini-3.5-flash-lite.
# - Ilustraciones nativas Gemini: requiere activar facturación (Pay-as-you-go) en Google AI Studio.
GEMINI_API_KEY=

# Modelos opcionales de Google Gemini (por defecto: gemini-3-flash-preview / gemini-3.1-flash-image)
# GEMINI_VISION_MODEL=gemini-3-flash-preview
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Respaldo GRATUITO recomendado para VISIÓN (ultrarrápido ~1s, 1000 req/día en https://console.groq.com/keys):
# GROQ_API_KEY=gsk_...
# Alternativa gratuita de visión (https://openrouter.ai/keys):
# OPENROUTER_API_KEY=sk-or-...

# Ilustraciones 100% IA GRATIS (recomendado — misma cuenta de Cloudflare que R2):
# Cloudflare Workers AI: 10.000 neuronas gratis/día con FLUX.1-schnell (sin marca de agua)
# Creá un API Token con permiso "Workers AI: Read" en https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Alternativas opcionales para ilustraciones IA:
# Hugging Face (https://huggingface.co/settings/tokens con permiso Inference Providers):
# HUGGINGFACE_API_KEY=hf_...
# OpenAI Images (gpt-image-1):
# OPENAI_API_KEY=sk-...

# ==============================================================================
# 2. Almacenamiento real en la nube (Firebase Firestore + Cloudflare R2 Bucket)
# ==============================================================================
# A) Base de datos Firestore (plan Spark gratuito: 1 GiB + 50k lecturas/día)
#    En Firebase Console -> Configuración del proyecto -> Cuentas de servicio -> Generar nueva clave privada.
#    Podés pegar el JSON completo en una sola línea (o codificado en base64) en FIREBASE_SERVICE_ACCOUNT_JSON:
FIREBASE_SERVICE_ACCOUNT_JSON=
#    O bien cargar los 3 campos por separado:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# B) Bucket de fotos e ilustraciones en Cloudflare R2 (10 GB/mes gratis, cero costos de salida/egress)
#    En Cloudflare Dashboard -> R2 Object Storage -> Crear bucket (ej. bioma-media) -> Manage R2 API Tokens
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=bioma-media
# Opcional: si habilitaste dominio público r2.dev o dominio propio en el bucket; si queda vacío, Bioma sirve los archivos de forma segura vía /api/media/
# CLOUDFLARE_R2_PUBLIC_URL=

# ==============================================================================
# 3. Autenticación real con Google + Protección de cuota de IA
# ==============================================================================
# ID de cliente OAuth 2.0 (Web) creado en Google Cloud Console -> APIs y servicios -> Credenciales
GOOGLE_CLIENT_ID=

# Correos de Google autorizados (separados por coma)
ALLOWED_EMAILS=valedepadua@gmail.com,damiyvale@gmail.com

# Clave secreta aleatoria (>=32 caracteres) para firmar la cookie HttpOnly de sesión en producción
AUTH_SESSION_SECRET=

# Forzar autenticación incluso en desarrollo (en producción siempre es obligatoria)
# REQUIRE_GOOGLE_AUTH=true

# ==============================================================================
# 4. Configuración opcional del cliente
# ==============================================================================
# Si el backend corre en otro dominio, indicá su URL base
VITE_BACKEND_API_URL=
