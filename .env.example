# ==============================================================================
# Motor de IA (SOLO SERVIDOR — nunca lleva prefijo VITE_ ni se expone al cliente)
# ==============================================================================
# Conseguí tu clave gratuita o de producción en https://aistudio.google.com/apikey
# Copiá este archivo como ".env" y completá GEMINI_API_KEY:
GEMINI_API_KEY=

# Modelos opcionales de Google Gemini (podés dejar los valores por defecto)
# GEMINI_VISION_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ==============================================================================
# Configuración opcional del cliente
# ==============================================================================
# Si el backend corre en otro dominio, indicá su URL base (en desarrollo Vite ya sirve /api/*)
VITE_BACKEND_API_URL=

# Firebase (respaldo real en la nube con cuenta de Google; opcional)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
